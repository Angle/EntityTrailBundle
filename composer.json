{
    "name": "anglemx/entity-trail-bundle",
    "description": "Automatic Doctrine entity audit log for Symfony — who changed what and when.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^5.4|^6.4|^7.0",
        "symfony/security-bundle": "^5.4|^6.4|^7.0",
        "symfony/twig-bundle": "^5.4|^6.4|^7.0",
        "doctrine/orm": "^2.11|^3.0",
        "doctrine/doctrine-bundle": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/yaml": "^5.4|^6.4|^7.0",
        "doctrine/doctrine-migrations-bundle": "^3.2"
    },
    "autoload": {
        "psr-4": { "Angle\\EntityTrailBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Angle\\EntityTrailBundle\\Tests\\": "tests/" }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
